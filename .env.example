# ============================================================================
#  Posta AI — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha os valores.
# ============================================================================

# ─── SUPABASE — obrigatório ────────────────────────────────────────────────
# Supabase.com → seu projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── ADMIN / CRON — obrigatório ────────────────────────────────────────────
ADMIN_EMAILS=voce@email.com
CRON_SECRET=

# ─── UPLOAD-POST — publicação em redes sociais ─────────────────────────────
# upload-post.com → Dashboard → API Keys
# Cada organização pode sobrescrever isso em Configurações → Integrações.
UPLOAD_POST_API_KEY=
UPLOAD_POST_API_URL=https://api.upload-post.com

# ─── APP URL — usado para montar links de aprovação e redirects ───────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── CIFRA DE CREDENCIAIS — obrigatório a partir da Fase 2 ─────────────────
# Usada pra cifrar tokens de integração por-organização (Z-API, Telegram)
# antes de gravar no banco. Gere com: openssl rand -hex 32
# Trocar essa chave invalida (não decifra mais) credenciais já salvas.
CREDENTIALS_ENCRYPTION_KEY=

# ─── E-MAIL TRANSACIONAL (Resend) — opcional ───────────────────────────────
# resend.com → API Keys | verifique um domínio em resend.com → Domains
RESEND_API_KEY=
EMAIL_FROM=Posta AI <notificacoes@seudominio.com>

# ─── WHATSAPP (Z-API) / TELEGRAM — sem env var global ──────────────────────
# Cada organização conecta sua própria instância/bot em
# Configurações → Comunicação. As credenciais ficam cifradas no banco
# (usando CREDENTIALS_ENCRYPTION_KEY acima), nunca em .env.

# ─── STRIPE / ASSINATURAS — opcional ────────────────────────────────────────
# dashboard.stripe.com (MODO TESTE) → Developers → API keys / Webhooks / Products
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Um Price ID por plano × intervalo (crie 3 produtos com preço mensal e anual):
NEXT_PUBLIC_STRIPE_STARTER_MONTHLY=price_
NEXT_PUBLIC_STRIPE_STARTER_ANNUAL=price_
NEXT_PUBLIC_STRIPE_PRO_MONTHLY=price_
NEXT_PUBLIC_STRIPE_PRO_ANNUAL=price_
NEXT_PUBLIC_STRIPE_AGENCY_MONTHLY=price_
NEXT_PUBLIC_STRIPE_AGENCY_ANNUAL=price_

# ============================================================================
#  Login com Google (opcional): configure em
#  Supabase → Authentication → Providers → Google (Client ID + Secret)
#  Não é variável de ambiente aqui — fica salvo no projeto Supabase.
# ============================================================================
